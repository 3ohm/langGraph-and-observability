# Every setting, with its default. Copy to .env for local runs and change what you need.
# Settings reads the process environment only; `langgraph dev` and Docker Compose load .env.
# An empty value means "not set": the setting keeps its default (or stays unset).
# Secrets are empty here. Never commit real values.
# A commented line "# NAME=value" is a sample of a vendor variable that a library reads
# itself (LangSmith, AWS, Kubernetes, TLS and proxy). Remove the "#" to use it.

# Runtime: dev | test | prod. In prod, a missing secret stops startup.
APP_ENV=dev
APP_GIT_SHA=unknown

# Postgres. The pool holds 1 to APP_DB_POOL_MAX connections; APP_DB_POOL_MAX is at least 2.
APP_DATABASE_URL=
APP_MIGRATION_DATABASE_URL=
APP_DB_POOL_MIN=1
APP_DB_POOL_MAX=10
APP_DB_MAX_LIFETIME_S=1800
APP_DB_CONNECT_TIMEOUT_S=10
APP_PGBOUNCER_MODE=false

# Checkpoint encryption at rest (optional). Vendor name, no APP_ prefix. Secret: LANGGRAPH_AES_KEY,
# 16, 24 or 32 bytes; it needs the `encryption` extra (pycryptodome). Empty: no encryption.
LANGGRAPH_AES_KEY=

# Queues (SQS; ElasticMQ locally). List values are JSON. Result sinks: log, sqs.
# APP_SQS_WAIT_SECONDS is SQS's long-poll wait, 0 to 20.
APP_AWS_REGION=us-east-1
# AWS credentials (boto3 reads them). On EKS, IRSA or EKS Pod Identity supplies them: set
# nothing. On your machine with real adapters or Bedrock, name a profile of ~/.aws/config.
# Docker Compose gives ElasticMQ the test keys itself (compose.yaml).
# AWS_PROFILE=my-profile
# A private CA for AWS endpoints, for example behind a TLS-inspecting proxy:
# AWS_CA_BUNDLE=/etc/ssl/certs/internal-ca.pem
APP_SQS_QUEUE_URL=
APP_SQS_ENDPOINT_URL=
APP_SQS_WAIT_SECONDS=20
APP_RESULT_QUEUE_URL=
APP_RESULT_SINKS=["log"]

# Worker and retention. Counts and times are 1 or more, the heartbeat is shorter than the
# lease, and the health port is 1 to 65535. Out of bounds, the worker does not start.
APP_WORKER_CONCURRENCY=4
APP_LEASE_SECONDS=60
APP_HEARTBEAT_SECONDS=15
APP_RECOVERY_INTERVAL_SECONDS=30
APP_DRAIN_TIMEOUT_SECONDS=45
APP_MAX_ATTEMPTS=3
APP_RUN_DEADLINE_SECONDS=900
APP_HEALTH_PORT=8080
APP_RETENTION_CHECKPOINT_DAYS=14
APP_RETENTION_RESULT_DAYS=90

# Agents. Extra agents are a JSON list of "module:SPEC" references.
APP_INTAKE_AGENT=incident_triage
APP_EXTRA_AGENTS=[]

# Adapters (simulated | real) and model (recorded | bedrock). Effort: low | medium | high | xhigh | max.
APP_ADAPTERS=simulated
APP_LLM_MODE=recorded
# Before a real run, make sure that this model ID works in your AWS account and Region
# (docs/release-checklist.md, O7). Where the bare ID does not run in your Region, use an
# inference profile ID, such as global.anthropic.claude-opus-5-5 or us.anthropic.claude-opus-5-5.
APP_BEDROCK_MODEL_ID=anthropic.claude-opus-5-5
APP_JUDGE_MODEL_ID=
APP_MODEL_EFFORT=medium
APP_MAX_OUTPUT_TOKENS=16000

# Kubernetes evidence. In a pod the adapter uses the in-cluster config; outside a cluster it
# reads the kubeconfig (default ~/.kube/config).
# KUBECONFIG=/path/to/kubeconfig
APP_CLUSTER_NAME=local
APP_LOG_TAIL_LINES=500

# Datadog evidence. Vendor names, no APP_ prefix. Secrets: DD_API_KEY, DD_APP_KEY.
DD_API_KEY=
DD_APP_KEY=
DD_SITE=datadoghq.com
APP_DD_LOOKBACK_MINUTES=30
APP_DD_MAX_EVENTS=50

# Code evidence. Secret: APP_GIT_TOKEN.
APP_GIT_TOKEN=
# The only hosts that checkouts fetch from and send the token to (JSON list).
APP_GIT_ALLOWED_HOSTS=["github.com"]
APP_CODE_BUDGET_CHARS=60000
APP_SOURCE_CACHE_DIR=/tmp/lps-source-cache
APP_SOURCE_CACHE_MAX_MB=2048
APP_SOURCE_MAP_FILE=
APP_SOURCE_ANNOTATION_REPO_KEY=lps.dev/source-repo
APP_SOURCE_ANNOTATION_COMMIT_KEY=lps.dev/source-commit
# The tree-sitter grammars that `make grammars` fetches. Empty: the library's user cache.
# The image sets /app/grammars. The agent never downloads a grammar.
APP_GRAMMAR_DIR=

# Tracing (LangSmith). Content: full | redacted | none; full is allowed only when APP_ENV=dev.
APP_TRACE_CONTENT=redacted
APP_TRACE_SAMPLING_RATE=1.0
# LangSmith's own variables (vendor names, no APP_ prefix; the legacy LANGCHAIN_* names also
# work). Tracing is on only when LANGSMITH_TRACING=true and LANGSMITH_API_KEY is set.
# Secret: LANGSMITH_API_KEY.
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# The project. Without it: langgraph-and-observability-<APP_ENV>.
# LANGSMITH_PROJECT=langgraph-and-observability-dev
# An API key that can reach more than one workspace also needs the workspace ID.
# LANGSMITH_WORKSPACE_ID=
# The endpoint. Without it: LangSmith Cloud, US region. The EU region:
# LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com
#
# Self-hosted LangSmith on your own network. The API is at /api/v1 on your host, and the key
# is an API key that your instance issued:
# LANGSMITH_ENDPOINT=https://langsmith.internal.example.com/api/v1
# LANGSMITH_API_KEY=
# A private CA that signs the instance's TLS certificate. The langsmith client sends with
# requests (REQUESTS_CA_BUNDLE); its async client uses httpx (SSL_CERT_FILE).
# REQUESTS_CA_BUNDLE=/etc/ssl/certs/internal-ca.pem
# SSL_CERT_FILE=/etc/ssl/certs/internal-ca.pem
# A proxy between the worker and LangSmith. NO_PROXY keeps the local services direct.
# HTTPS_PROXY=http://proxy.internal.example.com:3128
# NO_PROXY=localhost,127.0.0.1,postgres,elasticmq,.svc,.cluster.local

# The lease owner's name. The Deployment sets it to the pod's name (deploy/k8s); without it,
# the worker uses the host name.
# POD_NAME=worker-0

# Local runs, Studio and tests (simulated adapters).
# Empty APP_FIXTURES_DIR means the package's agents/incident_triage/fixtures directory.
APP_FIXTURES_DIR=
APP_STUDIO_FIXTURE=python-keyerror
APP_FAKE_CALL_LOG_DIR=
APP_FAKE_DATADOG_DELAY_S=0.0
