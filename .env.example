# Every setting, with its default. Copy to .env for local runs and change what you need.
# Settings reads the process environment only; `langgraph dev` and Docker Compose load .env.
# An empty value means "not set": the setting keeps its default (or stays unset).
# Secrets are empty here. Never commit real values.

# Runtime: dev | test | prod. In prod, a missing secret stops startup.
APP_ENV=dev
APP_GIT_SHA=unknown

# Postgres
APP_DATABASE_URL=
APP_MIGRATION_DATABASE_URL=
APP_DB_POOL_MIN=1
APP_DB_POOL_MAX=10
APP_DB_MAX_LIFETIME_S=1800
APP_DB_CONNECT_TIMEOUT_S=10
APP_PGBOUNCER_MODE=false

# Checkpoint encryption at rest (optional). Vendor name, no APP_ prefix. Secret: LANGGRAPH_AES_KEY,
# 16, 24 or 32 bytes; it needs the `encryption` extra (pycryptodome). Empty: no encryption.
LANGGRAPH_AES_KEY=

# Queues (SQS; ElasticMQ locally). List values are JSON. Result sinks: log, sqs.
APP_AWS_REGION=us-east-1
APP_SQS_QUEUE_URL=
APP_SQS_ENDPOINT_URL=
APP_SQS_WAIT_SECONDS=20
APP_RESULT_QUEUE_URL=
APP_RESULT_SINKS=["log"]

# Worker and retention
APP_WORKER_CONCURRENCY=4
APP_LEASE_SECONDS=60
APP_HEARTBEAT_SECONDS=15
APP_RECOVERY_INTERVAL_SECONDS=30
APP_DRAIN_TIMEOUT_SECONDS=45
APP_MAX_ATTEMPTS=3
APP_RUN_DEADLINE_SECONDS=900
APP_HEALTH_PORT=8080
APP_RETENTION_CHECKPOINT_DAYS=14
APP_RETENTION_RESULT_DAYS=90

# Agents. Extra agents are a JSON list of "module:SPEC" references.
APP_INTAKE_AGENT=incident_triage
APP_EXTRA_AGENTS=[]

# Adapters (simulated | real) and model (recorded | bedrock). Effort: low | medium | high | xhigh | max.
APP_ADAPTERS=simulated
APP_LLM_MODE=recorded
APP_BEDROCK_MODEL_ID=anthropic.claude-opus-5-5
APP_JUDGE_MODEL_ID=
APP_MODEL_EFFORT=medium
APP_MAX_OUTPUT_TOKENS=16000

# Kubernetes evidence
APP_CLUSTER_NAME=local
APP_LOG_TAIL_LINES=500

# Datadog evidence. Vendor names, no APP_ prefix. Secrets: DD_API_KEY, DD_APP_KEY.
DD_API_KEY=
DD_APP_KEY=
DD_SITE=datadoghq.com
APP_DD_LOOKBACK_MINUTES=30
APP_DD_MAX_EVENTS=50

# Code evidence. Secret: APP_GIT_TOKEN.
APP_GIT_TOKEN=
# The only hosts that checkouts fetch from and send the token to (JSON list).
APP_GIT_ALLOWED_HOSTS=["github.com"]
APP_CODE_BUDGET_CHARS=60000
APP_SOURCE_CACHE_DIR=/tmp/lps-source-cache
APP_SOURCE_CACHE_MAX_MB=2048
APP_SOURCE_MAP_FILE=
APP_SOURCE_ANNOTATION_REPO_KEY=lps.dev/source-repo
APP_SOURCE_ANNOTATION_COMMIT_KEY=lps.dev/source-commit

# Tracing (LangSmith). Content: full | redacted | none; full is allowed only when APP_ENV=dev.
APP_TRACE_CONTENT=redacted
APP_TRACE_SAMPLING_RATE=1.0

# Local runs, Studio and tests (simulated adapters).
# Empty APP_FIXTURES_DIR means the package's agents/incident_triage/fixtures directory.
APP_FIXTURES_DIR=
APP_STUDIO_FIXTURE=python-keyerror
APP_FAKE_CALL_LOG_DIR=
APP_FAKE_DATADOG_DELAY_S=0.0
